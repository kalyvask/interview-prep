# ─── Required ───────────────────────────────────────────────────────────
# Anthropic API key for question generation, grading, follow-ups, summary.
# Sign up at console.anthropic.com, add credit, create a key under
# Settings → API Keys. A full 5-question interview costs roughly $0.05-0.15
# in tokens thanks to prompt caching.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ─── Optional: ElevenLabs voice ─────────────────────────────────────────
# When set, the coach speaks each question with a natural voice. When
# absent, the app falls back to the browser's built-in SpeechSynthesis.
# Sign up at elevenlabs.io; free tier covers ~10K characters/month.
ELEVENLABS_API_KEY=
# Default voice IDs (pick one or browse elevenlabs.io/voice-library):
#   Sarah   EXAVITQu4vr4xnSDxMAi   warm, conversational female
#   Rachel  21m00Tcm4TlvDq8ikWAM   professional female
#   Adam    pNInz6obpgDQGcFmaJgB   deep, calm male
#   Antoni  ErXwobaYiN019PkySvjV   soft male, well-paced
#   Charlie IKne3meq5aSn9XLyUdCD   younger male, energetic
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMAi

# ─── Optional: OpenAI Whisper (higher-quality STT) ──────────────────────
# When set, voice answers are transcribed by Whisper instead of the
# browser's Web Speech API. Whisper is noticeably better on accents,
# fillers, and technical vocabulary. Without it, the app uses the browser
# (Chrome/Edge only).
OPENAI_API_KEY=

# ─── Optional: HeyGen LiveAvatar (photoreal interviewer face) ───────────
# Drop-in photoreal interviewer component at @/components/avatar/LiveAvatar.
# Heads up: **HeyGen API keys do NOT work for LiveAvatar** — you need a
# separate LiveAvatar key minted at https://app.liveavatar.com/developers
# (LiveAvatar is HeyGen's rebrand of the Interactive Avatar product).
# Grab an avatar UUID from the avatars library in the same dashboard.
LIVEAVATAR_API_KEY=
LIVEAVATAR_AVATAR_ID=
# Quality: very_high | high | medium | low. Higher = more bandwidth + quota.
LIVEAVATAR_QUALITY=high
# Sandbox mode burns no quota and is rate-limited. Set to false for real sessions.
LIVEAVATAR_SANDBOX=true
